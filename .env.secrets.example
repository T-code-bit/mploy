# DEPLOYMENT CREDENTIALS - SECURE
# Save this file locally as .env.secrets (DO NOT COMMIT)
# Replace the values below with your actual credentials

# Admin authentication (server-side only)
ADMIN_ACCESS_CODE=your-admin-access-code
ADMIN_EMAIL=your-admin-email
ADMIN_PASSWORD=your-admin-password
EMPLOYER_ACCESS_CODE=your-employer-access-code

# Paystack API Keys (for payments, if enabled)
PAYSTACK_PUBLIC_KEY=your-paystack-public-key-here
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here

# Stripe API Key (if Stripe billing is enabled)
STRIPE_SECRET_KEY=your-stripe-secret-key-here

# CAPTCHA verification (if enabled)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key-here

# Supabase Service Role Key (for internal functions)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

